# 依赖与工具
node_modules/
vendor/
.tooling/

# Python 虚拟环境与字节码。白板动画引擎会在包目录内自建 .venv
# （engine/scripts/prepare_env.py），顶层规则匹配不到嵌套路径，
# 2026-10-09 打包核查时它带着 1952 个文件 / 252M 差点被提交。
**/.venv/
**/__pycache__/
**/*.pyc

# 启动脚本的中转文件（运行产物）
.lwb-scratch-root.txt

# 测试与构建残留
**/.tmp-*/
.tmp/
.dsh-tmp/
.tmp-*.png

# 根目录一次性调试脚本（点开头的 .tmp-*.cjs / .tmp-*.mjs）。
# 上面的 **/.tmp-*/ 只匹配目录，匹配不到这些散落在仓库根的临时探针；
# 它们不属于任何测试套件，也不该被 git add -A 收进去。
/.tmp-*.cjs
/.tmp-*.mjs

# 名字里带全角冒号的临时探针（Windows 保留设备名类残留的变体）。
# 该字符会让按目录递归的 grep / rg 直接报错中断，别让它混进版本库。
*.tmpwatch-postman.mjs

# 本地调试草稿目录（含浏览器 profile、Remotion 缓存、npm 缓存，实测 8.3GB）
# 2026-10-27 补入：此前未忽略，git add -A 会试图收录全部运行时缓存。
lifa-scratch/
video-check/

# Windows 保留设备名残留。该文件会让全仓 grep/rg 直接报 os error 1，
# 中断任何按目录递归的搜索。
nul

# Runtime state and local credentials
.dsh/
.env
.env.*
!.env.example
lwb/local/
.workbuddy/

# 构建产物
lwb/lib/

# 系统与本地
.DS_Store

# 本地备份（开发过程产物，不发布）
.backup-*/
local

# 测试输出与临时产物，不进仓库
test-run*.log
*.log
*.partial.*
review-frames/

# 交付包构建产物（体积大，不入库）
dist/
